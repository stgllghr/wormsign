# ws_al_001_mass_visibility_flip: Several repositories made public by one actor within an hour (high)
action="repo.access" visibility="public" previous_visibility IN ("private", "internal")

| sort 0 _time
| streamstats time_window=1h dc(repo) as value_count by actor

| search value_count >= 3
| dedup actor

# ws_al_001_repo_made_public_with_token: Repository made public with a token (medium)
action="repo.access" visibility="public" previous_visibility IN ("private", "internal") programmatic_access_type=*
