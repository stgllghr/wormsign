# ws_al_002_worm_runner_online: Self-hosted runner with a worm runner name came online or took a job (critical)
action IN ("repo.self_hosted_runner_online", "org.self_hosted_runner_online", "enterprise.self_hosted_runner_online", "workflows.prepared_workflow_job") runner_name="SHA1HULUD"

# ws_al_002_runner_registered_off_allowlist: Self-hosted runner registered by an identity not on the allowlist (medium)
action IN ("repo.register_self_hosted_runner", "org.register_self_hosted_runner", "enterprise.register_self_hosted_runner") NOT actor="runner-provisioner[bot]"
