# ws_al_004_worm_branch_job: Job started on a Shai-Hulud worm branch (critical)
action="workflows.prepared_workflow_job" job_workflow_ref IN ("*@refs/heads/shai-hulud", "*@shai-hulud", "*@refs/heads/dependabot/github_actions/format/setup-formatter", "*@dependabot/github_actions/format/setup-formatter") OR job_workflow_ref IN ("*@refs/heads/add-linter-workflow-*", "*@add-linter-workflow-*")

# ws_al_004_new_workflow_run_deleted_by_token: New workflow's run deleted with a token within the hour (critical)
| multisearch
[ search action="workflows.created_workflow_run" run_number=1 | eval event_type="ws_al_004_new_workflow_first_run" ]
[ search action="workflows.delete_workflow_run" run_number=1 programmatic_access_type=* | eval event_type="ws_al_004_workflow_run_deleted_by_token" ]

| sort 0 _time
| streamstats time_window=1h dc(event_type) as event_type_count by repo workflow_id

| search event_type_count >= 2
| dedup repo workflow_id

# ws_al_004_worm_branch_run: Workflow run on a Shai-Hulud worm branch (critical)
action="workflows.created_workflow_run" head_branch IN ("shai-hulud", "dependabot/github_actions/format/setup-formatter") OR head_branch="add-linter-workflow-*"
