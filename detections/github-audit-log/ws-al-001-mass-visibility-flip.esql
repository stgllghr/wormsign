# Reference conversion of ws-al-001-mass-visibility-flip.yml to Elasticsearch ES|QL. Generated; do not edit.
# Generated by detections/tools/convert_rules.py: sigma convert -t esql --without-pipeline detections/github-audit-log/ws-al-001-mass-visibility-flip.yml, then the edits below.
# Post-processed by convert_rules.py (not run in Elasticsearch; checked against the ES|QL reference only):
# - string comparisons are on to_lower(field) with a lower-case value: ==, in, like, starts_with and ends_with are
#   case-sensitive in ES|QL and Sigma's values are not;
# - each `not` wraps its operand in coalesce(..., false), so an event without the field passes a not filter as in
#   Sigma, instead of being dropped as null;
# - like patterns double each literal backslash, which like reads as its escape character;
# - ES|QL has no sliding window: a correlation counts in clock-aligned buckets of its timespan and in a second set
#   offset by half of it. Each alert is one the Sigma rule raises. A burst within half the timespan is always
#   caught; a longer one only when one bucket holds it whole.
# sigma-cli 3.1.0, pySigma 1.5.1, pySigma-backend-elasticsearch 2.1.1.
# No processing pipeline: the fields are the rule's own, and no index, source type or table is set.
# Each query follows a line naming the Sigma rule it comes from; base rules of a correlation have none.
# Rule sha256: 506af6e12d20a43975529c981561787ed395916515ffec7cf498633898862c25

# ws_al_001_mass_visibility_flip: Several repositories made public by one actor within an hour (high)
from * metadata _id, _index, _version | where to_lower(action) == "repo.access" and to_lower(visibility) == "public" and to_lower(previous_visibility) in ("private", "internal")
| eval timebucket=mv_append(date_trunc(1 hour, @timestamp), date_trunc(1 hour, @timestamp + 30 minutes) - 30 minutes) | stats value_count=count_distinct(repo) by timebucket, actor
| where value_count >= 3

# ws_al_001_repo_made_public_with_token: Repository made public with a token (medium)
from * metadata _id, _index, _version | where to_lower(action) == "repo.access" and to_lower(visibility) == "public" and to_lower(previous_visibility) in ("private", "internal") and programmatic_access_type is not null
