# Reference conversion of ws-al-004-worm-workflow-run.yml to Elasticsearch ES|QL. Generated; do not edit.
# Generated by detections/tools/convert_rules.py: sigma convert -t esql --without-pipeline detections/github-audit-log/ws-al-004-worm-workflow-run.yml, then the edits below.
# Post-processed by convert_rules.py (not run in Elasticsearch; checked against the ES|QL reference only):
# - string comparisons are on to_lower(field) with a lower-case value: ==, in, like, starts_with and ends_with are
#   case-sensitive in ES|QL and Sigma's values are not;
# - each `not` wraps its operand in coalesce(..., false), so an event without the field passes a not filter as in
#   Sigma, instead of being dropped as null;
# - like patterns double each literal backslash, which like reads as its escape character;
# - ES|QL has no sliding window: a correlation counts in clock-aligned buckets of its timespan and in a second set
#   offset by half of it. Each alert is one the Sigma rule raises. A burst within half the timespan is always
#   caught; a longer one only when one bucket holds it whole.
# sigma-cli 3.1.0, pySigma 1.5.1, pySigma-backend-elasticsearch 2.1.1.
# No processing pipeline: the fields are the rule's own, and no index, source type or table is set.
# Each query follows a line naming the Sigma rule it comes from; base rules of a correlation have none.
# Rule sha256: 5848a4ccc3b4bef2c5d89e80fe6dc5cd712db13324b1598204f6a8d1afb84f39

# ws_al_004_worm_branch_job: Job started on a Shai-Hulud worm branch (critical)
from * metadata _id, _index, _version | where to_lower(action) == "workflows.prepared_workflow_job" and (ends_with(to_lower(job_workflow_ref), "@refs/heads/shai-hulud") or ends_with(to_lower(job_workflow_ref), "@shai-hulud") or ends_with(to_lower(job_workflow_ref), "@refs/heads/dependabot/github_actions/format/setup-formatter") or ends_with(to_lower(job_workflow_ref), "@dependabot/github_actions/format/setup-formatter") or to_lower(job_workflow_ref) like "*@refs/heads/add-linter-workflow-*" or to_lower(job_workflow_ref) like "*@add-linter-workflow-*")

# ws_al_004_new_workflow_run_deleted_by_token: New workflow's run deleted with a token within the hour (critical)
from * metadata _id, _index, _version | where (to_lower(action) == "workflows.created_workflow_run" and run_number == 1) or (to_lower(action) == "workflows.delete_workflow_run" and run_number == 1 and programmatic_access_type is not null)
| eval event_type=case(to_lower(action) == "workflows.created_workflow_run" and run_number == 1, "ws_al_004_new_workflow_first_run", to_lower(action) == "workflows.delete_workflow_run" and run_number == 1 and programmatic_access_type is not null, "ws_al_004_workflow_run_deleted_by_token")
| eval timebucket=mv_append(date_trunc(1 hour, @timestamp), date_trunc(1 hour, @timestamp + 30 minutes) - 30 minutes) | stats event_type_count=count_distinct(event_type) by timebucket, repo, workflow_id
| where event_type_count >= 2

# ws_al_004_worm_branch_run: Workflow run on a Shai-Hulud worm branch (critical)
from * metadata _id, _index, _version | where to_lower(action) == "workflows.created_workflow_run" and (to_lower(head_branch) in ("shai-hulud", "dependabot/github_actions/format/setup-formatter") or starts_with(to_lower(head_branch), "add-linter-workflow-"))
