# ws_ep_002_node_runs_repository_hook_loader: Node.js Runs a Repository's .claude or .vscode setup.mjs (Shai-Hulud Repository Hook) (high)
from * metadata _id, _index, _version | where (ends_with(to_lower(Image), "/node") or ends_with(to_lower(Image), "\\node.exe")) and (to_lower(CommandLine) like "*.claude/setup.mjs*" or to_lower(CommandLine) like "*.vscode/setup.mjs*" or to_lower(CommandLine) like "*.claude\\\\setup.mjs*" or to_lower(CommandLine) like "*.vscode\\\\setup.mjs*")
